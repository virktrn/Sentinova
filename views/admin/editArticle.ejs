<div class="editor-page">

    <div class="editor-header">

        <h1>
            <%= mode === 'edit'
                    ? 'Edit Article'
                    : 'Create Article' %>
        </h1>

        <p>
            Publish and manage your news content.
        </p>

    </div>

    <form
            method="POST"
            action="<%= mode === 'edit'
                    ? '/admin/edit/' + article.id
                    : '/admin/create' %>"
            id="articleForm"
    >

        <div class="editor-grid">

            <!-- LEFT SIDE -->

            <div class="editor-main">

                <div class="form-card">

                    <label>Article Title</label>

                    <input
                            type="text"
                            id="titleInput"
                            name="title"
                            value="<%= article?.title || '' %>"
                            required
                    >

                </div>

                <div class="form-card">

                    <label>Slug Preview</label>

                    <div id="slugPreview">
                        <%= article?.slug || 'article-slug-preview' %>
                    </div>

                </div>

                <div class="form-card">

                    <label>Summary</label>

                    <textarea
                            name="summary"
                            rows="5"
                    ><%= article?.summary || '' %></textarea>

                </div>

                <div class="form-card">

                    <label>Article Content</label>

                    <div id="editor">
                        <%- article?.content || '' %>
                    </div>

                    <input
                            type="hidden"
                            name="content"
                            id="contentInput"
                    >

                </div>

            </div>

            <!-- RIGHT SIDE -->

            <div class="editor-sidebar">

                <div class="form-card">

                    <label>Category</label>

                    <select name="category">

                        <option value="Technology">
                            Technology
                        </option>

                        <option value="Business">
                            Business
                        </option>

                        <option value="Sports">
                            Sports
                        </option>

                        <option value="Entertainment">
                            Entertainment
                        </option>

                        <option value="Health">
                            Health
                        </option>

                        <option value="World">
                            World
                        </option>

                    </select>

                </div>

                <div class="form-card">

                    <label>Author</label>

                    <input
                            type="text"
                            name="author"
                            value="<%= article?.author || '' %>"
                    >

                </div>

                <div class="form-card">

                    <label>Image URL</label>

                    <input
                            type="text"
                            id="imageInput"
                            name="image"
                            value="<%= article?.image || '' %>"
                    >

                </div>

                <div class="form-card">

                    <label>Image Preview</label>

                    <img
                            id="imagePreview"
                            class="preview-image"
                            src="<%= article?.image || '' %>"
                    >

                </div>

                <button
                        type="submit"
                        class="publish-btn"
                >
                    Publish Article
                </button>

            </div>

        </div>

    </form>

</div>

<link
        href="https://cdn.quilljs.com/1.3.6/quill.snow.css"
        rel="stylesheet"
>

<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

<script>

    const quill = new Quill(
        "#editor",
        {
            theme:"snow"
        }
    );

    document
        .getElementById("articleForm")
        .addEventListener(
            "submit",
            function(){

                document
                    .getElementById(
                        "contentInput"
                    ).value =
                    quill.root.innerHTML;

            }
        );

    const imageInput =
        document.getElementById(
            "imageInput"
        );

    const imagePreview =
        document.getElementById(
            "imagePreview"
        );

    imageInput.addEventListener(
        "input",
        ()=>{
            imagePreview.src =
                imageInput.value;
        }
    );

    const titleInput =
        document.getElementById(
            "titleInput"
        );

    const slugPreview =
        document.getElementById(
            "slugPreview"
        );

    titleInput.addEventListener(
        "input",
        ()=>{

            slugPreview.innerText =
                titleInput.value
                    .toLowerCase()
                    .replace(
                        /[^a-z0-9]+/g,
                        "-"
                    );

        }
    );

</script>