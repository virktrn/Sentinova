<div class="auth-page">

    <div class="auth-left">

        <div class="auth-brand">

            <h1>Welcome Back</h1>

            <p>
                Stay informed with the latest news,
                trends, and stories from around the world.
            </p>

            <ul>
                <li>📰 Real-time News Updates</li>
                <li>🚀 AI Powered Content</li>
                <li>🌎 Global Coverage</li>
                <li>📱 Responsive Experience</li>
            </ul>

        </div>

    </div>

    <div class="auth-right">

        <div class="auth-card">

            <h2>Sign In</h2>

            <p>
                Access your Sentinova account
            </p>

            <form
                    method="POST"
                    action="/auth/login"
            >

                <div class="input-group">

                    <label>Email</label>

                    <input
                            type="email"
                            name="email"
                            placeholder="Enter email"
                            required
                    >

                </div>

                <div class="input-group">

                    <label>Password</label>

                    <input
                            type="password"
                            name="password"
                            placeholder="Enter password"
                            required
                    >

                </div>

                <button
                        type="submit"
                        class="auth-btn"
                >
                    Login
                </button>

            </form>

            <div class="auth-footer">

                Don't have an account?

                <a href="/auth/register">
                    Register
                </a>

            </div>

        </div>

    </div>

</div>